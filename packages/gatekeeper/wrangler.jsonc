// The one Gatekeeper Worker: every library in `packages/gatekeeper-shared/src/libraries.ts`, behind private RPC.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "open-data-pt-gatekeeper",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-09",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  // A library's vars are declared with their values in its `deployment.ts`; only what varies by deployment is bound here.
  // Secrets (wrangler secret put): ML_CONSUMER_KEY, ML_CONSUMER_SECRET (Metro Lisboa), NASA_FIRMS_MAP_KEY (NASA FIRMS).
  // Declared by name so deploy fails when one is missing and `wrangler types` types them.
  "secrets": { "required": ["ML_CONSUMER_KEY", "ML_CONSUMER_SECRET", "NASA_FIRMS_MAP_KEY"] },
  // The libraries this Worker carries: empty is every one of them, which is what a deployment wants.
  // `pnpm dev <library>` overrides it with --var, because a `.dev.vars` key that `secrets.required`
  // does not list is dropped before the Worker sees it
  // (https://developers.cloudflare.com/workers/wrangler/configuration/#secrets-configuration-property).
  "vars": { "GATEKEEPER_LIBRARIES": "" },
  // Parliament stages its 93 MB initiatives file to answer not-modified without parsing it.
  "r2_buckets": [{ "binding": "PARLIAMENT_STAGING", "bucket_name": "open-data-pt-gatekeeper-staging" }],
  // GTFS archives and Parliament's file need two minutes of CPU; a limit is a ceiling, not a cost.
  "limits": { "cpu_ms": 120000 },
  // The kernel records every acquisition's outcome; a tenth of invocations is enough to debug.
  // Each span counts as one observability event against the same quota as logs.
  "observability": {
    "logs": { "enabled": true, "head_sampling_rate": 0.1, "invocation_logs": true, "persist": true },
    "traces": { "enabled": true, "head_sampling_rate": 0.1, "persist": true },
  },
}
