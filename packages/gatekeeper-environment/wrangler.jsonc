// Generated by `pnpm packages:sync` from the deployment declarations (worker.ts) of the libraries its feeds use; do not edit.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "open-data-pt-gatekeeper-environment",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-09",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "ARCGIS_ALLOWED_HOSTS": "services.arcgis.com,sniambgeoogc.apambiente.pt",
    "IPMA_API_ORIGIN": "https://api.ipma.pt",
    "OGC_ALLOWED_HOSTS": "ogcapi.dgterritorio.gov.pt,ambiente.azores.gov.pt",
  },
  "observability": {
    "enabled": true,
    // The kernel records every acquisition's outcome; a tenth of invocations is enough to debug.
    "head_sampling_rate": 0.1,
  },
}
