// Generated by `pnpm packages:sync` from the deployment declaration (worker.ts) of the gtfs library; do not edit.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "open-data-pt-gatekeeper-gtfs",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-09",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "GTFS_ALLOWED_HOSTS": "api.carrismetropolitana.pt,dadosabertos.cm-porto.pt,dados.gov.pt,publico.cp.pt,www.fertagus.pt,www.metrodoporto.pt,www.tub.pt,backend.tcbarreiro.pt,www.horariosdofunchal.pt",
  },
  "limits": { "cpu_ms": 120000 },
  "observability": {
    "enabled": true,
    // The kernel records every acquisition's outcome; a tenth of invocations is enough to debug.
    "head_sampling_rate": 0.1,
  },
}
