// Generated by `pnpm packages:sync` from the deployment declarations (worker.ts) of the libraries its feeds use; do not edit.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "open-data-pt-gatekeeper-economy",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-09",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "vars": { "BPSTAT_API_ORIGIN": "https://bpstat.bportugal.pt", "EUROSTAT_API_ORIGIN": "https://ec.europa.eu", "INE_API_ORIGIN": "https://www.ine.pt" },
  "observability": {
    "enabled": true,
    // The kernel records every acquisition's outcome; a tenth of invocations is enough to debug.
    "head_sampling_rate": 0.1,
  },
}
